<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  @file        SpectaDockPin.entitlements
  @description Entitlements for SpectaDockPin: not sandboxed (DESIGN §7, §13 decision 2). The app reads the
               Dock's preferences (com.apple.dock) directly, which the sandbox forbids (DESIGN §3 S4).
               The Accessibility permission is a TCC grant at runtime, not an entitlement.
  @author      Kennt Kim
  @company     Calida Lab
  @created     2026-10-18
  @lastUpdated 2026-10-18
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
